#keyword arguments
def pharmacy(name,disease,symptoms,age):
    print("patient name is:",name)
    print("disease is:",disease)
    print("age is:",age)
    print("observed symptoms:",symptoms)
    if(disease=="stomach pain"):
        print("take metformin")
    else:
        print("consult doctor")
   

pharmacy(name="hema",age=25,disease="stomach pain",symptoms="cramp")
pharmacy(name="nisha",age=25,disease="eye problem",symptoms="cramp")













